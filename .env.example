LLM_PROVIDER="ollama"
LLM_MODEL="qwen3.6:27b"
LLM_ENDPOINT="http://127.0.0.1:11434/v1"
LLM_API_KEY="ollama"
LLM_TEMPERATURE="0.0"

EMBEDDING_PROVIDER="fastembed"
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIMENSIONS="384"

COGNEE_SHARED_ROOT="/absolute/path/to/cognee-research-memory/.cognee_data"

# Canonical RAG storage and index identity
RAG_DATA_ROOT="/absolute/path/to/cognee-research-memory/data"
PROVENANCE_DB_PATH="/absolute/path/to/cognee-research-memory/data/provenance.sqlite3"
# Embedded persistent Qdrant is the default. Set QDRANT_URL for server mode.
QDRANT_URL=""
QDRANT_PATH="/absolute/path/to/cognee-research-memory/data/qdrant"
QDRANT_COLLECTION="research_chunks_v1"
INDEX_VERSION="v1"

# Retrieval infrastructure (independent from the answer model)
DENSE_EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
DENSE_EMBEDDING_DIMENSIONS="384"
SPARSE_EMBEDDING_MODEL="Qdrant/bm25"
RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"
EMBEDDING_DEVICE="cpu"
RERANKER_DEVICE="cuda"

DENSE_CANDIDATES="40"
SPARSE_CANDIDATES="40"
GRAPH_CANDIDATES="10"
COGNEE_GRAPH_ENABLED="true"
COGNEE_SEARCH_TIMEOUT_SECONDS="3"
COGNEE_PROMOTION_TIMEOUT_SECONDS="120"
RERANK_CANDIDATES="30"
FINAL_CONTEXT_CHUNKS="10"
ANSWER_CONTEXT_TOKENS="12000"

# Localhost-only services
OLLAMA_BASE_URL="http://127.0.0.1:11434"
DEFAULT_GENERATOR_MODEL="qwen3.6:27b"
OLLAMA_GENERATION_TIMEOUT_SECONDS="120"
DEFAULT_GENERATION_TEMPERATURE="0.0"
RAG_API_HOST="127.0.0.1"
RAG_API_PORT="8000"
MCP_HOST="127.0.0.1"
MCP_PORT="8001"

# JSON list; keep this narrow and add only directories intentionally indexed.
APPROVED_INGESTION_ROOTS='["/path/to/repos", "/path/to/papers"]'
